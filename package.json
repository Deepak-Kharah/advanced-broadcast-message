{
  "name": "advanced-broadcast-message",
  "version": "0.0.1-alpha.1",
  "description": "Inspired from post robot, this module is designed to provide a simple interface for the inter tab communication using the Broadcast channel.",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "module": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "prepare": "npm run build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prettier": "prettier src --check",
    "prettier:fix": "prettier src --write",
    "format": "npm run prettier:fix && npm run lint:fix"
  },
  "author": {
    "name": "Deepak Kharah",
    "email": "42672761+Deepak-Kharah@users.noreply.github.com",
    "url": "https://www.deepakkharah.com/"
  },
  "repository": "github:Deepak-Kharah/advanced-broadcast-message",
  "bugs": {
    "url": "https://github.com/Deepak-Kharah/advanced-broadcast-message/issues"
  },
  "license": "MIT",
  "dependencies": {
    "broadcast-channel": "^7.3.0",
    "lodash-es": "^4.18.1",
    "zalgo-promise": "^1.0.48"
  },
  "keywords": [
    "broadcast-message",
    "post-robot"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/lodash-es": "^4.17.12",
    "@types/zalgo-promise": "^1.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.15.0",
    "happy-dom": "^20.10.6",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.1.12",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,css}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
